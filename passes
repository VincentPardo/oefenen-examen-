class PassGraph:
    def __init__(self):
        self.players=[]
        self.adj=dict() #key=sender_name, waarden=lijst van pass objecten
        
    def add_player(self,player:Player):
        # VERBETERING: Gebruik has_player voor consistentie
        if not self.has_player(player):
            self.players.append(player)
            self.adj[player.name] = []  # Initialiseer lege lijst voor deze speler
            
    def has_player(self,speler):
        # VERBETERING: Correcte implementatie
        if isinstance(speler,Player):
            return speler in self.players
        elif isinstance(speler,str):
            gevonden = False
                for p in self.players:
                    if p.name == speler:
                        gevonden = True
                        break  # Stop bij eerste match
                return gevonden
        return False
        
    def get_player(self,name):
        for player in self.players:
            if player.name==name:
                return player
        return None
        
    def add_pass(self,sender,receiver,nr_of_times=1):
        # VERBETERING: Controle op geldige spelers
        if not (self.has_player(sender) and self.has_player(receiver)):
            raise ValueError("Sender or receiver not in graph")
            
        if nr_of_times <= 0:  # VERBETERING: <= 0 in plaats van < 0
            raise ValueError("nr_of_times must be greater than 0")
            
        sender_name = sender.name
        receiver_name = receiver.name
        
        # VERBETERING: Zoek bestaande pass
        for pass_obj in self.adj[sender_name]:
            if pass_obj.receiver.name == receiver_name:
                pass_obj.nr_of_times += nr_of_times
                return
                
        # Nieuwe pass toevoegen
        new_pass = Pass(sender, receiver, nr_of_times)
        self.adj[sender_name].append(new_pass)
        
    def get_pass(self,sender_name,receiver_name):
        # VERBETERING: Correcte implementatie
        if sender_name not in self.adj:
            return None
            
        for pass_obj in self.adj[sender_name]:
            if pass_obj.receiver.name == receiver_name:
                return pass_obj
        return None
        
    def neighbors(self,sender_name):
        # VERBETERING: Return kopie om interne lijst te beschermen
        return self.adj.get(sender_name, [])[:]
        
    def total_weight(self,subset=None):  # VERBETERING: singular (total_weight)
        total = 0
        if subset is None:
            # Alle passes in de graaf
            for sender_name in self.adj:
                for pass_obj in self.adj[sender_name]:
                    total += pass_obj.get_weight()
        else:
            # VERBETERING: Correcte implementatie voor subset
            subset_names = set(subset)  # Voor efficiënte lookup
            for sender_name in self.adj:
                if sender_name in subset_names:
                    for pass_obj in self.adj[sender_name]:
                        if pass_obj.receiver.name in subset_names:
                            total += pass_obj.get_weight()
        return total
        
    def pass_intensity(self, subset: list[str] | None = None) -> float:
        if subset is None:
            subset = [p.name for p in self.players]
            
        n = len(subset)
        if n < 2:
            return 0.0
            
        teller = self.total_weight(subset)
        noemer = n * (n - 1)  # VERBETERING: n*(n-1) voor gerichte graaf
        
        return teller / noemer if noemer > 0 else 0.0
        
    def top_pairs(self, k=5):
        # VERBETERING: Correcte implementatie
        all_passes = []
        for sender_name in self.adj:
            all_passes.extend(self.adj[sender_name])
            
        # Sorteer op weight (aflopend)
        all_passes.sort(key=lambda p: p.get_weight(), reverse=True)
        
        return all_passes[:k]
        
    def distribution_from(self, sender_name):
        # VERBETERING: Correcte implementatie
        if sender_name not in self.adj:
            return []
            
        distribution = []
        for pass_obj in self.adj[sender_name]:
            distribution.append((pass_obj.receiver.name, pass_obj.get_weight()))
            
        # Sorteer aflopend op count
        distribution.sort(key=lambda x: x[1], reverse=True)
        return distribution


